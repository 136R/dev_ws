<?xml version="1.0"?>
<!-- NeuPAN 窄道测试世界：一条走廊，三道逐渐变窄的门（缝宽 0.5 / 0.4 / 0.3 m）。
     机器人实宽 ~0.22 m。起点(0,0)，目标约(5.5,0)。
     配合窄道测试建议 astar robot_radius:=0.1（否则全局规划穿不过窄缝）。 -->
<sdf version="1.6">
    <world name="corridor">

        <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
        <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
        <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
        <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry><plane><normal>0 0 1</normal></plane></geometry>
                </collision>
                <visual name="visual">
                    <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
                    <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
                </visual>
            </link>
        </model>

        <!-- 走廊外墙：x 从 -1 到 6，y 两侧 ±1.5 -->
        <model name="wall_top"><static>true</static><pose>2.5 1.5 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>7 0.1 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>7 0.1 1</size></box></geometry></visual>
            </link>
        </model>
        <model name="wall_bottom"><static>true</static><pose>2.5 -1.5 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>7 0.1 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>7 0.1 1</size></box></geometry></visual>
            </link>
        </model>
        <model name="wall_west"><static>true</static><pose>-1 0 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.1 3 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.1 3 1</size></box></geometry></visual>
            </link>
        </model>
        <model name="wall_east"><static>true</static><pose>6 0 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.1 3 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.1 3 1</size></box></geometry></visual>
            </link>
        </model>

        <!-- 门1 x=1.3，缝宽 0.5 -->
        <model name="gate1_up"><static>true</static><pose>1.3 0.875 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.1 1.25 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.1 1.25 1</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual>
            </link>
        </model>
        <model name="gate1_dn"><static>true</static><pose>1.3 -0.875 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.1 1.25 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.1 1.25 1</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material></visual>
            </link>
        </model>

        <!-- 门2 x=3.0，缝宽 0.4 -->
        <model name="gate2_up"><static>true</static><pose>3.0 0.85 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.1 1.3 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.1 1.3 1</size></box></geometry>
                    <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material></visual>
            </link>
        </model>
        <model name="gate2_dn"><static>true</static><pose>3.0 -0.85 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.1 1.3 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.1 1.3 1</size></box></geometry>
                    <material><ambient>0.9 0.6 0.1 1</ambient><diffuse>0.9 0.6 0.1 1</diffuse></material></visual>
            </link>
        </model>

        <!-- 门3 x=4.5，缝宽 0.3（接近机器人极限）-->
        <model name="gate3_up"><static>true</static><pose>4.5 0.825 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.1 1.35 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.1 1.35 1</size></box></geometry>
                    <material><ambient>0.7 0.2 0.8 1</ambient><diffuse>0.7 0.2 0.8 1</diffuse></material></visual>
            </link>
        </model>
        <model name="gate3_dn"><static>true</static><pose>4.5 -0.825 0.5 0 0 0</pose>
            <link name="link">
                <collision name="c"><geometry><box><size>0.1 1.35 1</size></box></geometry></collision>
                <visual name="v"><geometry><box><size>0.1 1.35 1</size></box></geometry>
                    <material><ambient>0.7 0.2 0.8 1</ambient><diffuse>0.7 0.2 0.8 1</diffuse></material></visual>
            </link>
        </model>

    </world>
</sdf>

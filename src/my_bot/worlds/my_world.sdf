                    </geometry>
                    <material>
                        <ambient>0.4 0.8 0.4 1</ambient>
                        <diffuse>0.4 0.8 0.4 1</diffuse>
                    </material>
                </visual>
            </link>

            <!-- row y=-0.30: center gate line -->
            <link name="obstacle_center_row_1">
                <pose>-1.05 -0.30 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>

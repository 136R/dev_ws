            <link name="obstacle_center_row_3">
                <pose>0.95 -0.30 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.9 0.6 0.1 1</ambient>
                        <diffuse>0.9 0.6 0.1 1</diffuse>
                    </material>
                </visual>
            </link>

            <!-- row y=0.30: shifted gate line -->
            <link name="obstacle_upper_row_1">
                <pose>-1.55 0.30 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.4 0.9 1</ambient>
                        <diffuse>0.6 0.4 0.9 1</diffuse>
                    </material>
                </visual>
            </link>
            <link name="obstacle_upper_row_2">
                <pose>-0.55 0.30 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.6 0.4 0.9 1</ambient>
                        <diffuse>0.6 0.4 0.9 1</diffuse>
                    </material>
                </visual>
            </link>
            <link name="obstacle_upper_row_3">
                <pose>0.45 0.30 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>

                        <diffuse>0.6 0.4 0.9 1</diffuse>
                    </material>
                </visual>
            </link>

            <!-- side pockets: short dead-end branches for local planner recovery tests -->
            <link name="obstacle_left_deadend_cap">
                <pose>-1.35 0.75 0.20 0 0 1.5708</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                    <material>

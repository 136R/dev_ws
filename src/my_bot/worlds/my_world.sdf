                    <material>
                        <ambient>0.3 0.6 0.9 1</ambient>
                        <diffuse>0.3 0.6 0.9 1</diffuse>
                    </material>
                </visual>
            </link>

            <!-- vertical blockers build S turns and dead ends -->
            <link name="obstacle_lower_turn_left">
                <pose>-1.1 -0.35 0.20 0 0 1.5708</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>
                    <material>
                        <ambient>0.4 0.8 0.4 1</ambient>
                        <diffuse>0.4 0.8 0.4 1</diffuse>
                    </material>
                </visual>
            </link>
            <link name="obstacle_lower_turn_right">
                <pose>1.15 -0.35 0.20 0 0 1.5708</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>

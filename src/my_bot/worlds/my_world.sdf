            <!-- row y=1.10: north gate line -->
            <link name="obstacle_north_row_1">
                <pose>-1.05 1.10 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.60 0.03 0.40</size>
                        </box>
                    </geometry>

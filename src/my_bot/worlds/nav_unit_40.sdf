<?xml version="1.0"?>
<sdf version="1.6">
    <world name="default">

        <!-- 基础物理和场景插件 -->
        <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
        <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />
        <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />

        <!-- 传感器插件（激光雷达、摄像头等需要这个）-->
        <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <!-- IMU插件 -->
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

        <!-- 光源 -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- 地面 -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 右墙 x=2 -->
        <model name="wall_1">
            <static>true</static>
            <pose>2 0 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.1 4 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.1 4 1</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- 前墙 y=2 -->
        <model name="wall_2">
            <static>true</static>
            <pose>0 2 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>4 0.1 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>4 0.1 1</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- 左墙 x=-2 -->
        <model name="wall_3">
            <static>true</static>
            <pose>-2 0 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>0.1 4 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>0.1 4 1</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- 后墙 y=-2 -->
        <model name="wall_4">
            <static>true</static>
            <pose>0 -2 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <box>
                            <size>4 0.1 1</size>
                        </box>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <box>
                            <size>4 0.1 1</size>
                        </box>
                    </geometry>
                </visual>
            </link>
        </model>

        <!-- ========== NeuPAN 40cm 单场景测试场 ==========
             A 东侧直通道 / B 西北走廊+门洞 / C 西南绕墙头掉头；三区互不相通，各自只能走那条窄路。
             墙厚 0.03、高 0.40，只用 0°/90°（obstacle_* 命名供 nav_route_test 读真值）。
             测试终点：A (1.75,0)  B (-1.3,1.45)  C (-0.3,-1.73)，起点原点。 -->
        <model name="nav_unit_obstacles">
            <static>true</static>
            <pose>0 0 0 0 0 0</pose>
            <link name="obstacle_a_channel_n">
                <pose>1.000 0.215 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry><box><size>1.000 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.000 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
            <link name="obstacle_a_channel_s">
                <pose>1.000 -0.215 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry><box><size>1.000 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.000 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
            <link name="obstacle_a_barrier_n">
                <pose>0.500 0.550 0.20 0 0 1.5708</pose>
                <collision name="collision">
                    <geometry><box><size>0.670 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.670 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
            <link name="obstacle_a_barrier_s">
                <pose>0.500 -0.600 0.20 0 0 1.5708</pose>
                <collision name="collision">
                    <geometry><box><size>0.770 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.770 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
            <link name="obstacle_b_corridor_low">
                <pose>-1.175 0.420 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry><box><size>1.550 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.550 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
            <link name="obstacle_b_door_west">
                <pose>-1.725 0.900 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry><box><size>0.450 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.450 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
            <link name="obstacle_b_door_east">
                <pose>0.425 0.900 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry><box><size>3.050 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>3.050 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
            <link name="obstacle_c_upper">
                <pose>0.700 -1.000 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry><box><size>2.500 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>2.500 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
            <link name="obstacle_c_mid">
                <pose>0.350 -1.500 0.20 0 0 0</pose>
                <collision name="collision">
                    <geometry><box><size>3.200 0.03 0.40</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>3.200 0.03 0.40</size></box></geometry>
                    <material><ambient>0.8 0.3 0.3 1</ambient><diffuse>0.8 0.3 0.3 1</diffuse></material>
                </visual>
            </link>
        </model>

    </world>
</sdf>

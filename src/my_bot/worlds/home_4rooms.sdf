<?xml version="1.0"?>
<!--
  多房间户型：移动垃圾桶"召唤上门"的仿真场地。

  ⚠️ 这里每个数字都是被 4 米激光量程反推出来的。
  （lidar.xacro 的 max=4.0 和 mapper_params_sim.yaml 的 max_laser_range=4.0
   是刻意的省资源设计，不改。所以是世界迁就激光，不是激光迁就世界。）

  房间内净尺寸 2.7 x 2.7 m
      对角线 3.82 m < 4 m，站房间任一角都能看到整间。

  走廊净宽 1.5 m
      两侧墙恒在 0.75 m 处，横向约束强，不会左右漂。

  走廊门洞间距 最大 2.2 m   ← ⚠️ 最吃紧的一条
      走廊是两条平行直线，纵向没有特征，全靠门洞开口提供不连续性。
      南北门洞刻意错开（北 -2.8/0/2.8，南 -2.2/0.7/3.4），
      保证任何位置 4 m 内都至少能看到一个门洞。改门位时务必守住这条。

  门宽 0.9 m
      footprint 半宽 0.121 + global inflation_radius 0.2，留 0.5 m 低代价通道；
      NeuPAN 碰撞半宽 0.11，余量充足。别降到 0.7 以下。

  每间家具 1 箱 + 1 柱
      不是为了避障，是给 slam_toolbox 提供扫描匹配特征。
      空房间 + 4 m 激光 = 真的会漂。别删。

  房间中心（标导航点用；家具已让开，半径 1.1 m 内无遮挡）:
      北侧  (-2.8, 2.2)  ( 0.0, 2.2)  ( 2.8, 2.2)
      南侧  (-2.8,-2.2)  ( 0.0,-2.2)  ( 2.8,-2.2)
      HOME 建议放走廊西端 (-3.6, 0)。机器人 spawn 在 (0,0)。

  用法: ros2 launch my_bot launch_sim.launch.py world:=<本文件绝对路径>
-->
<sdf version="1.6">
    <world name="default">

        <!-- 基础物理和场景插件 -->
        <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics" />
        <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands" />
        <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster" />

        <!-- 传感器插件（激光雷达、摄像头等需要这个）-->
        <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>

        <!-- IMU插件 -->
        <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />

        <!-- 光源 -->
        <light type="directional" name="sun">
            <cast_shadows>true</cast_shadows>
            <pose>0 0 10 0 0 0</pose>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
            <attenuation>
                <range>1000</range>
                <constant>0.9</constant>
                <linear>0.01</linear>
                <quadratic>0.001</quadratic>
            </attenuation>
            <direction>-0.5 0.1 -0.9</direction>
        </light>

        <!-- 地面 -->
        <model name="ground_plane">
            <static>true</static>
            <link name="link">
                <collision name="collision">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                        </plane>
                    </geometry>
                </collision>
                <visual name="visual">
                    <geometry>
                        <plane>
                            <normal>0 0 1</normal>
                            <size>100 100</size>
                        </plane>
                    </geometry>
                    <material>
                        <ambient>0.8 0.8 0.8 1</ambient>
                        <diffuse>0.8 0.8 0.8 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- ==================== 外墙（8.4 × 7.2 m 外框） ==================== -->

        <model name="wall_north">
            <static>true</static>
            <pose>0 3.6 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>8.5 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>8.5 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="wall_south">
            <static>true</static>
            <pose>0 -3.6 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>8.5 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>8.5 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="wall_west">
            <static>true</static>
            <pose>-4.2 0 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.1 7.3 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.1 7.3 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="wall_east">
            <static>true</static>
            <pose>4.2 0 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.1 7.3 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.1 7.3 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <!-- ============ 走廊北墙 y=0.8，门洞在 x = -2.8 / 0.0 / 2.8 ============ -->
        <!-- 墙段: [-4.2,-3.25] [-2.35,-0.45] [0.45,2.35] [3.25,4.2] -->

        <model name="corridor_n_seg1">
            <static>true</static>
            <pose>-3.725 0.8 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.95 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.95 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="corridor_n_seg2">
            <static>true</static>
            <pose>-1.4 0.8 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.9 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.9 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="corridor_n_seg3">
            <static>true</static>
            <pose>1.4 0.8 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.9 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.9 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="corridor_n_seg4">
            <static>true</static>
            <pose>3.725 0.8 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.95 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.95 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <!-- ===== 走廊南墙 y=-0.8，门洞在 x = -2.2 / 0.7 / 3.4（刻意与北侧错开）===== -->
        <!-- 墙段: [-4.2,-2.65] [-1.75,0.25] [1.15,2.95] [3.85,4.2] -->

        <model name="corridor_s_seg1">
            <static>true</static>
            <pose>-3.425 -0.8 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.55 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.55 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="corridor_s_seg2">
            <static>true</static>
            <pose>-0.75 -0.8 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>2.0 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>2.0 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="corridor_s_seg3">
            <static>true</static>
            <pose>2.05 -0.8 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.8 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.8 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="corridor_s_seg4">
            <static>true</static>
            <pose>4.025 -0.8 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.35 0.1 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.35 0.1 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <!-- ==================== 房间隔墙 ==================== -->

        <model name="divider_n_west">
            <static>true</static>
            <pose>-1.4 2.2 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.1 2.8 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.1 2.8 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="divider_n_east">
            <static>true</static>
            <pose>1.4 2.2 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.1 2.8 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.1 2.8 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="divider_s_west">
            <static>true</static>
            <pose>-1.4 -2.2 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.1 2.8 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.1 2.8 1</size></box></geometry>
                </visual>
            </link>
        </model>

        <model name="divider_s_east">
            <static>true</static>
            <pose>1.4 -2.2 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.1 2.8 1</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.1 2.8 1</size></box></geometry>
                </visual>
            </link>
        </model>


        <!-- ==================== 家具 ====================
             ⚠️ 不是为了避障 —— 是给 slam_toolbox 提供扫描匹配特征。
             空房间 + 4 m 激光 = 真的会漂。别删。

             刻意做成【每间都不一样】：品类、尺寸、高度、朝向、贴哪面墙都不同。
             六间屋子如果长得一模一样，回环检测会误匹配（把卧室认成书房）。
             激光在离地约 0.11~0.16 m，所以只要高于 0.2 m 都扫得到，矮沙发也算数。

             房间中心（=导航点）周围留空 >= 0.75 m，门到中心的通道留空。
        -->
        <!-- 客厅·长沙发（贴北墙，矮而长） -->
        <model name="n1_sofa">
            <static>true</static>
            <pose>-3.45 3.2 0.225 0 0 0.0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.3 0.55 0.45</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.3 0.55 0.45</size></box></geometry>
                    <material>
                        <ambient>0.72 0.63 0.48 1</ambient>
                        <diffuse>0.72 0.63 0.48 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 客厅·茶几（斜放，矮） -->
        <model name="n1_table">
            <static>true</static>
            <pose>-1.95 2.95 0.19 0 0 0.6</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.55 0.45 0.38</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.55 0.45 0.38</size></box></geometry>
                    <material>
                        <ambient>0.75 0.32 0.28 1</ambient>
                        <diffuse>0.75 0.32 0.28 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 客厅·落地灯（细高） -->
        <model name="n1_lamp">
            <static>true</static>
            <pose>-1.75 1.3 0.65 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><cylinder><radius>0.1</radius><length>1.3</length></cylinder></geometry>
                </collision>
                <visual name="visual">
                    <geometry><cylinder><radius>0.1</radius><length>1.3</length></cylinder></geometry>
                    <material>
                        <ambient>0.88 0.62 0.20 1</ambient>
                        <diffuse>0.88 0.62 0.20 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 厨房·整排橱柜（贴北墙，长直边） -->
        <model name="n2_counter">
            <static>true</static>
            <pose>0.0 3.28 0.45 0 0 0.0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>2.1 0.42 0.9</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>2.1 0.42 0.9</size></box></geometry>
                    <material>
                        <ambient>0.55 0.57 0.60 1</ambient>
                        <diffuse>0.55 0.57 0.60 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 厨房·圆餐桌 -->
        <model name="n2_table">
            <static>true</static>
            <pose>-1.0 1.5 0.37 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><cylinder><radius>0.35</radius><length>0.74</length></cylinder></geometry>
                </collision>
                <visual name="visual">
                    <geometry><cylinder><radius>0.35</radius><length>0.74</length></cylinder></geometry>
                    <material>
                        <ambient>0.25 0.65 0.62 1</ambient>
                        <diffuse>0.25 0.65 0.62 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 厨房·立式垃圾桶（小方） -->
        <model name="n2_bin">
            <static>true</static>
            <pose>1.05 1.42 0.35 0 0 0.35</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.32 0.32 0.7</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.32 0.32 0.7</size></box></geometry>
                    <material>
                        <ambient>0.38 0.65 0.42 1</ambient>
                        <diffuse>0.38 0.65 0.42 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 卧室·床（贴北墙，占半间） -->
        <model name="n3_bed">
            <static>true</static>
            <pose>2.8 3.1 0.25 0 0 0.0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.8 0.8 0.5</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.8 0.8 0.5</size></box></geometry>
                    <material>
                        <ambient>0.30 0.55 0.80 1</ambient>
                        <diffuse>0.30 0.55 0.80 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 卧室·衣柜（贴东墙，高） -->
        <model name="n3_wardrobe">
            <static>true</static>
            <pose>3.85 1.6 0.775 0 0 0.0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.5 1.0 1.55</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.5 1.0 1.55</size></box></geometry>
                    <material>
                        <ambient>0.72 0.63 0.48 1</ambient>
                        <diffuse>0.72 0.63 0.48 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 卧室·脏衣篓（球） -->
        <model name="n3_basket">
            <static>true</static>
            <pose>1.78 1.35 0.22 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><sphere><radius>0.22</radius></sphere></geometry>
                </collision>
                <visual name="visual">
                    <geometry><sphere><radius>0.22</radius></sphere></geometry>
                    <material>
                        <ambient>0.60 0.40 0.72 1</ambient>
                        <diffuse>0.60 0.40 0.72 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 书房·书桌（贴南墙） -->
        <model name="s1_desk">
            <static>true</static>
            <pose>-3.35 -3.15 0.375 0 0 0.0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.4 0.6 0.75</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>1.4 0.6 0.75</size></box></geometry>
                    <material>
                        <ambient>0.72 0.63 0.48 1</ambient>
                        <diffuse>0.72 0.63 0.48 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 书房·书架（贴西墙，顶天） -->
        <model name="s1_shelf">
            <static>true</static>
            <pose>-3.95 -1.7 0.9 0 0 0.0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.35 1.6 1.8</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.35 1.6 1.8</size></box></geometry>
                    <material>
                        <ambient>0.75 0.32 0.28 1</ambient>
                        <diffuse>0.75 0.32 0.28 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 书房·圆凳（矮胖） -->
        <model name="s1_stool">
            <static>true</static>
            <pose>-1.7 -1.4 0.225 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
                </collision>
                <visual name="visual">
                    <geometry><cylinder><radius>0.2</radius><length>0.45</length></cylinder></geometry>
                    <material>
                        <ambient>0.38 0.65 0.42 1</ambient>
                        <diffuse>0.38 0.65 0.42 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 储物·大纸箱（乱堆，斜） -->
        <model name="s2_crate_a">
            <static>true</static>
            <pose>-1.0 -3.1 0.475 0 0 0.3</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.65 0.6 0.95</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.65 0.6 0.95</size></box></geometry>
                    <material>
                        <ambient>0.88 0.62 0.20 1</ambient>
                        <diffuse>0.88 0.62 0.20 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 储物·小纸箱（斜） -->
        <model name="s2_crate_b">
            <static>true</static>
            <pose>-0.85 -1.5 0.275 0 0 0.95</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.42 0.42 0.55</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.42 0.42 0.55</size></box></geometry>
                    <material>
                        <ambient>0.72 0.63 0.48 1</ambient>
                        <diffuse>0.72 0.63 0.48 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 储物·铁桶 -->
        <model name="s2_drum">
            <static>true</static>
            <pose>1.05 -3.05 0.5 0 0 0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><cylinder><radius>0.26</radius><length>1.0</length></cylinder></geometry>
                </collision>
                <visual name="visual">
                    <geometry><cylinder><radius>0.26</radius><length>1.0</length></cylinder></geometry>
                    <material>
                        <ambient>0.55 0.57 0.60 1</ambient>
                        <diffuse>0.55 0.57 0.60 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 储物·中纸箱（贴东墙） -->
        <model name="s2_crate_c">
            <static>true</static>
            <pose>1.05 -1.6 0.35 0 0 0.15</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>0.5 0.5 0.7</size></box></geometry>
                </collision>
                <visual name="visual">
                    <geometry><box><size>0.5 0.5 0.7</size></box></geometry>
                    <material>
                        <ambient>0.75 0.32 0.28 1</ambient>
                        <diffuse>0.75 0.32 0.28 1</diffuse>
                    </material>
                </visual>
            </link>
        </model>

        <!-- 卫生间·洗手台（贴南墙，长条） -->
        <model name="s3_vanity">
            <static>true</static>
            <pose>2.15 -3.22 0.425 0 0 0.0</pose>
            <link name="link">
                <collision name="collision">
                    <geometry><box><size>1.25 0.5 0.85</size></box></geometry>
                </collision>

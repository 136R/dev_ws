<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="robot">

    <xacro:arg name="sim_mode" default="true" />
    <xacro:arg name="ros2_control_config" default="" />
    <!-- LiDAR extrinsics (base_link -> laser_frame). Defaults match current model. -->
    <xacro:arg name="lidar_x" default="-0.025" />
    <xacro:arg name="lidar_y" default="0" />
    <xacro:arg name="lidar_z" default="0.1058" />
    <xacro:arg name="lidar_roll" default="0" />
    <xacro:arg name="lidar_pitch" default="0" />
    <xacro:arg name="lidar_yaw" default="${pi}" />

    <xacro:include filename="robot_core.xacro" />

    <!-- <xacro:include filename="gazebo_control.xacro"/> -->

    <xacro:if value="$(arg sim_mode)">
        <xacro:include filename="ros2_control.xacro" />
    </xacro:if>

    <xacro:unless value="$(arg sim_mode)">
        <xacro:include filename="$(arg ros2_control_config)" />
    </xacro:unless>

    <xacro:include filename="lidar.xacro" />
    <xacro:include filename="imu.xacro" />

</robot>
